{
  "name": "Kiseru",
  "description": "A keyboard-first web navigation Chrome extension.",
  "homepage_url": "https://github.com/mrouhi13/kiseru",
  "version": "1.0",
  "manifest_version": 3,
  "permissions": ["tabs", "sessions"],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "scripts/background.js"
  },
  "content_scripts": [
    {
      "js": ["dist/content.js"],
      "css": ["styles.css"],
      "matches": ["<all_urls>"],
      "run_at": "document_idle",
      "all_frames": true
    }
  ],
  "action": {
    "default_icon": "icon.png"
  },
  "icons": {
    "16": "icon.png",
    "48": "icon.png",
    "128": "icon.png"
  }
}
